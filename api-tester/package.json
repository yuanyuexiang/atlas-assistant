{
  "name": "atlas-api-tester",
  "version": "1.0.0",
  "description": "Atlas Assistant API 测试工具",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js",
    "test:prod": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js --env=prod",
    "test:local": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js --env=local",
    "test:auth": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js --module=auth",
    "test:agents": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js --module=agents",
    "test:knowledge": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js --module=knowledge",
    "test:conversations": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js --module=conversations",
    "test:chat": "NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js --module=chat"
  },
  "keywords": ["api", "test", "atlas"],
  "author": "",
  "license": "MIT"
}
